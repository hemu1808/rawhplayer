{
  "name": "rawh-player",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "High-Fidelity Audiophile Desktop Player powered by Tauri + Rust DSP",
  "author": "Rawh Audio",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check:native": "node scripts/check-native.mjs",
    "generate:ipc": "node scripts/check-native.mjs generate",
    "test:native:hardware": "node scripts/check-native.mjs hardware",
    "test:native:desktop": "node scripts/native-smoke.mjs",
    "benchmark:library": "node scripts/check-native.mjs benchmark",
    "test:release": "node --test scripts/*.test.mjs",
    "release:inventory": "node scripts/release-inventory.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:release && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/michroma": "^5.2.7",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "jsmediatags": "^3.9.5",
    "lucide-react": "^1.62.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.18",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
