{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RawhPlayer",
  "version": "3.0.0",
  "identifier": "com.rawhplayer.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rawh Player",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: blob:; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://generativelanguage.googleapis.com https://www.googleapis.com https://api.lyrics.ovh https://api.acoustid.org https://musicbrainz.org; media-src 'self' blob: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mp3"],
        "mimeType": "audio/mpeg",
        "description": "MP3 Audio"
      },
      {
        "ext": ["flac"],
        "mimeType": "audio/flac",
        "description": "FLAC Audio"
      },
      {
        "ext": ["wav"],
        "mimeType": "audio/wav",
        "description": "WAV Audio"
      },
      {
        "ext": ["ogg"],
        "mimeType": "audio/ogg",
        "description": "OGG Audio"
      },
      {
        "ext": ["aac"],
        "mimeType": "audio/aac",
        "description": "AAC Audio"
      },
      {
        "ext": ["m4a"],
        "mimeType": "audio/mp4",
        "description": "M4A Audio"
      },
      {
        "ext": ["aiff"],
        "mimeType": "audio/aiff",
        "description": "AIFF Audio"
      },
      {
        "ext": ["dsf"],
        "mimeType": "audio/dsf",
        "description": "DSD Audio (DSF)"
      },
      {
        "ext": ["dff"],
        "mimeType": "audio/dff",
        "description": "DSD Audio (DFF)"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hemu1808/rawhplayer/releases/latest/download/updater.json"
      ],
      "pubkey": "placeholder"
    }
  }
}
